{
  "info": {
    "name": "8주차 즐겨찾기 · 트랜잭션 시나리오",
    "description": "위에서부터 순서대로 Send 하세요. 로그인하면 토큰이 자동으로 저장됩니다. (회원 A는 7주차 시나리오와 같은 계정)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "favMovieId", "value": "550" },
    { "key": "recordMovieId", "value": "278" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0. 로그인 (토큰 저장)",
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('token', body.result.accessToken);"
      ] } }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"week8test@umc.com\",\n  \"password\": \"Password123!\"\n}" }
      }
    },
    {
      "name": "1. 토큰 없이 즐겨찾기 등록 → 401 AUTH401_2",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('401 AUTH401_2', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().code).to.eql('AUTH401_2'); });"
      ] } }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/favorites",
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{favMovieId}}\n}" }
      }
    },
    {
      "name": "2. 등록 전 여부 조회 → isFavorite: false",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('isFavorite false', () => pm.expect(pm.response.json().result.isFavorite).to.eql(false));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/favorites/{{favMovieId}}" }
    },
    {
      "name": "3. 즐겨찾기 등록 → 201",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201 COMMON201', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().code).to.eql('COMMON201'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/favorites",
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{favMovieId}}\n}" }
      }
    },
    {
      "name": "4. 같은 영화 다시 등록 → 409 FAVORITE409_1",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('409 FAVORITE409_1', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('FAVORITE409_1'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/favorites",
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{favMovieId}}\n}" }
      }
    },
    {
      "name": "5. movieId 0 → 400",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('400', () => pm.response.to.have.status(400));"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/favorites",
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": 0\n}" }
      }
    },
    {
      "name": "6. 내 즐겨찾기 목록 (최신순)",
      "request": { "method": "GET", "url": "{{baseUrl}}/favorites" }
    },
    {
      "name": "7. 등록 후 여부 조회 → isFavorite: true",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('isFavorite true', () => pm.expect(pm.response.json().result.isFavorite).to.eql(true));"
      ] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/favorites/{{favMovieId}}" }
    },
    {
      "name": "8. 즐겨찾기 해제 → 200 result: null",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 result null', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().result).to.eql(null); });"
      ] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/favorites/{{favMovieId}}" }
    },
    {
      "name": "9. 없는 즐겨찾기 해제 → 404 FAVORITE404_1",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('404 FAVORITE404_1', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().code).to.eql('FAVORITE404_1'); });"
      ] } }],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/favorites/{{favMovieId}}" }
    },
    {
      "name": "10. 영화 기록 저장 (평점 + 즐겨찾기) → 201",
      "event": [{ "listen": "test", "script": { "exec": [
        "const r = pm.response.json().result;",
        "pm.test('rating과 favorite 모두 존재', () => { pm.expect(r.rating).to.not.eql(null); pm.expect(r.favorite).to.not.eql(null); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/movie-records",
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{recordMovieId}},\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화입니다.\",\n  \"addToFavorites\": true\n}" }
      }
    },
    {
      "name": "11. 같은 영화 기록 다시 저장 → 409 RATING409_1",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('409 RATING409_1', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().code).to.eql('RATING409_1'); });"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/movie-records",
        "body": { "mode": "raw", "raw": "{\n  \"movieId\": {{recordMovieId}},\n  \"score\": 5,\n  \"comment\": \"다시 보고 싶은 영화입니다.\",\n  \"addToFavorites\": true\n}" }
      }
    }
  ]
}
