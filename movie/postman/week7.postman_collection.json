        {
          "name": "payload 변조 토큰",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/members/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tamperedToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const parts = pm.collectionVariables.get(\"tokenA\").split(\".\");",
                  "const payload = JSON.parse(atob(parts[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "payload.sub = payload.sub === \"1\" ? \"2\" : \"1\";",
                  "parts[1] = btoa(JSON.stringify(payload)).replace(/=/g, \"\").replace(/\\+/g, \"-\").replace(/\\//g, \"_\");",
                  "pm.collectionVariables.set(\"tamperedToken\", parts.join(\".\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test(\"isSuccess\", () => pm.expect(body.isSuccess).to.eql(false));",
                  "pm.test(\"AUTH401_3\", () => pm.expect(body.code).to.eql(\"AUTH401_3\"));"
                ]
              }
            }
          ]
        }
