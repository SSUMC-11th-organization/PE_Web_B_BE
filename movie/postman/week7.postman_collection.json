        {
          "name": "1-1. A 회원가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/members",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nicknameA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = Date.now().toString(36);",
                  "pm.collectionVariables.set(\"emailA\", `a-${run}@umc.com`);",
                  "pm.collectionVariables.set(\"emailB\", `b-${run}@umc.com`);",
                  "pm.collectionVariables.set(\"nicknameA\", `A${run}`);",
                  "pm.collectionVariables.set(\"nicknameB\", `B${run}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"isSuccess\", () => pm.expect(body.isSuccess).to.eql(true));",
                  "pm.test(\"COMMON201\", () => pm.expect(body.code).to.eql(\"COMMON201\"));"
                ]
              }
            }
          ]
        },
