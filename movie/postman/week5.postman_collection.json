{
  "info": {
    "name": "UMC Week5 Movie API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "닉네임 중복",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/%EC%88%98%ED%98%84"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"응답 계약\", () => {pm.expect(pm.response.json().available).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "닉네임 사용 가능",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/%EC%83%88%EB%8B%89%EB%84%A4%EC%9E%84"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"응답 계약\", () => {pm.expect(pm.response.json().available).to.eql(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "이메일 중복",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/email/noco@umc.com"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"응답 계약\", () => {pm.expect(pm.response.json().available).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "이메일 사용 가능",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/email/new@umc.com"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"응답 계약\", () => {pm.expect(pm.response.json().available).to.eql(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "회원 평점 최신순",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"응답 계약\", () => {const data=pm.response.json(); pm.expect(data).to.be.an(\"array\"); for(let i=1;i<data.length;i++) pm.expect(data[i-1].ratingId).to.be.above(data[i].ratingId); data.forEach(r=>{pm.expect(r).to.have.all.keys(\"ratingId\",\"movieId\",\"score\",\"comment\",\"createdAt\",\"updatedAt\");});});"
            ]
          }
        }
      ]
    },
    {
      "name": "없는 회원",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/9223372036854775807/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "닉네임 형식 오류",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/a"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "이메일 형식 오류",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/email/not-email"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
